[Unit]
Description=WealthAI ETF/Stock Scheduler
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wealthai-backend2/Schedulers/etf_stock_scheduler
Environment="PATH=/home/ubuntu/wealthai-backend2/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/ubuntu/wealthai-backend2"

# Start the ETF/Stock scheduler
ExecStart=/home/ubuntu/wealthai-backend2/.venv/bin/python scheduler.py

# Restart on failure
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/home/ubuntu/wealthai-backend2/Schedulers/logs/etf_scheduler.log
StandardError=append:/home/ubuntu/wealthai-backend2/Schedulers/logs/etf_scheduler_error.log

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
